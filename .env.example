# ============================================================================
# AegisPilot environment configuration
# Copy this file to `.env` and fill in your values. NEVER commit `.env`.
# Two modes: (A) free-tier AI Studio key, or (B) full GCP via Vertex + ADC.
# ============================================================================

# ---------------------------------------------------------------------------
# MODE A — Free tier (Google AI Studio API key, no billing)
# ---------------------------------------------------------------------------
# GEMINI_API_KEY=paste_your_ai_studio_key_here
# GOOGLE_GENAI_USE_VERTEXAI=false

# ---------------------------------------------------------------------------
# MODE B — Full Google Cloud (billing active). Auth via Application Default
# Credentials — run:  gcloud auth application-default login   (NO API key)
# ---------------------------------------------------------------------------
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your_project_id
GOOGLE_CLOUD_LOCATION=us-central1     # compute region: Firestore / Pub/Sub / Cloud Run
VERTEX_LOCATION=global                # model region: gemini-3.5-flash is published in 'global'

# --- Models (Flash for all six agents; Pro tier for RCA in Phase 5) ---
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODEL_PRO=gemini-2.5-pro       # gemini-3.5-pro not yet published on Vertex; one-line swap when it is

# --- Backend / orchestrator selection (local impls always kept as fallback) ---
BACKEND=local                         # local | cloud  (SQLite/in-proc  vs  Firestore/Pub-Sub)
ORCHESTRATOR=adk                      # local | adk    (custom  vs  real google-adk Runner)

# --- Retry/backoff for the 503-safe wrapper (Vertex throttles too) ---
GEMINI_MAX_RETRIES=5
GEMINI_BASE_DELAY=1.0

# --- Optional Slack webhook (console fallback if unset) ---
SLACK_WEBHOOK_URL=

# --- Live Prometheus / Grafana (K8s Day-3+ vision; auto-snapshot when unset on alert) ---
# PROMETHEUS_URL=http://3.111.113.151:9090
# GRAFANA_URL=http://3.111.113.151:3000
# GRAFANA_TOKEN=
# LOKI_URL=http://3.111.113.151:3100

# --- Server ---
HOST=0.0.0.0
PORT=8080

# --- Remediation (simulate | docker | kubernetes) ---
# simulate  = dry-run + seed Fire (offline / tests)
# docker    = Compose live Fire via scrape /admin/fault (see docker-compose.yml)
# kubernetes = K3s live Fire via Deployment env patch
# REMEDIATION_MODE=simulate
# K8S_NAMESPACE=aegispilot

# --- Docker Compose scrape overrides (defaults: http://<svc>:8080) ---
# SCRAPE_URL_CHECKOUT=http://checkout-svc:8080
# SCRAPE_URL_CART=http://cart-svc:8080
# SCRAPE_URL_PAYMENTS=http://payments-svc:8080
